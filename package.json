{
  "name": "live-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "Live quiz ในห้องเรียน (Express + ws + TypeScript)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reset": "node -e \"const f=process.env.DB_PATH||'data/live-quiz.db';for(const x of [f,f+'-wal',f+'-shm'])require('fs').rmSync(x,{force:true})\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
